{
  "jobs": [
    {
      "name": "adapter-296-horizons",
      "task": "train",
      "data": "data/combined-landscape",
      "output": "runs/cloud/adapter-296-horizons",
      "arguments": [
        "--epochs",
        "70",
        "--patience",
        "12",
        "--batch-size",
        "1024",
        "--width",
        "256",
        "--layers",
        "4",
        "--components",
        "12",
        "--anchors",
        "--preload",
        "--init-checkpoint",
        "runs/cloud/landscape-seed42/best.pt",
        "--lr",
        "0.00008",
        "--stratified-energy",
        "--energy-weight",
        "1",
        "--nll-weight",
        "0.1",
        "--precision",
        "bf16",
        "--horizon-adapter",
        "--freeze-backbone",
        "--driver-base-features",
        "180"
      ]
    },
    {
      "name": "adapter-296-horizons-validation",
      "task": "evaluate",
      "data": "data/combined-landscape",
      "output": "runs/cloud/adapter-296-horizons-validation",
      "arguments": [
        "--checkpoints",
        "runs/cloud/adapter-296-horizons/best.pt",
        "--splits",
        "val_individual",
        "val_temporal",
        "--batch-size",
        "256",
        "--samples",
        "64"
      ]
    },
    {
      "name": "adapter-296-regimes",
      "task": "train",
      "data": "data/combined-landscape",
      "output": "runs/cloud/adapter-296-regimes",
      "arguments": [
        "--epochs",
        "70",
        "--patience",
        "12",
        "--batch-size",
        "1024",
        "--width",
        "256",
        "--layers",
        "4",
        "--components",
        "12",
        "--anchors",
        "--preload",
        "--init-checkpoint",
        "runs/cloud/landscape-seed42/best.pt",
        "--lr",
        "0.00008",
        "--stratified-energy",
        "--energy-weight",
        "1",
        "--nll-weight",
        "0.1",
        "--precision",
        "bf16",
        "--horizon-adapter",
        "--freeze-backbone",
        "--driver-base-features",
        "180",
        "--regime-weight",
        "0.1"
      ]
    },
    {
      "name": "adapter-296-regimes-validation",
      "task": "evaluate",
      "data": "data/combined-landscape",
      "output": "runs/cloud/adapter-296-regimes-validation",
      "arguments": [
        "--checkpoints",
        "runs/cloud/adapter-296-regimes/best.pt",
        "--splits",
        "val_individual",
        "val_temporal",
        "--batch-size",
        "256",
        "--samples",
        "64"
      ]
    }

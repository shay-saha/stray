      "arguments": ["--epochs", "30", "--patience", "7", "--batch-size", "512", "--width", "128", "--layers", "3", "--anchors", "--init-checkpoint", "runs/v2-all-anchored/best.pt", "--lr", "0.0001", "--stratified-energy", "--energy-weight", "1", "--nll-weight", "0.1", "--precision", "bf16"]

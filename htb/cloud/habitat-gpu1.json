{
  "jobs": [
    {
      "name": "habitat-priors",
      "task": "habitat-cache",
      "data": "data/combined-landscape",
      "output": "runs/cloud/habitat-priors",
      "arguments": [
        "--base-data",
        "data/combined-memory",
        "--checkpoints",
        "runs/cloud/combined-no-memory-control/best.pt",
        "runs/cloud/combined-memory-medium-seed17/best.pt",
        "runs/cloud/combined-memory-large/best.pt",
        "--count",
        "256"
      ]
    },
    {
      "name": "habitat-residual-seed42",
      "task": "habitat-train",
      "data": "data/combined-landscape",
      "output": "runs/cloud/habitat-residual-seed42",
      "arguments": [
        "--cache",
        "runs/cloud/habitat-priors",
        "--fields",
        "data/destination-fields",
        "--seed",
        "42"
      ]
    },
    {
      "name": "habitat-residual-seed42-validation",
      "task": "evaluate",
      "data": "data/combined-landscape",
      "output": "runs/cloud/habitat-residual-seed42-validation",
      "arguments": [
        "--checkpoints",
        "runs/cloud/habitat-residual-seed42/best.pt",
        "--splits",
        "val_individual",
        "val_temporal",
        "--batch-size",
        "128",
        "--samples",
        "64"
      ]
    },
    {
      "name": "habitat-residual-seed17",
      "task": "habitat-train",
      "data": "data/combined-landscape",
      "output": "runs/cloud/habitat-residual-seed17",
      "arguments": [
        "--cache",
        "runs/cloud/habitat-priors",
        "--fields",
        "data/destination-fields",
        "--seed",
        "17"
      ]
    },
    {
      "name": "habitat-residual-seed17-validation",
      "task": "evaluate",
      "data": "data/combined-landscape",
      "output": "runs/cloud/habitat-residual-seed17-validation",
      "arguments": [
        "--checkpoints",
        "runs/cloud/habitat-residual-seed17/best.pt",
        "--splits",
        "val_individual",
        "val_temporal",
        "--batch-size",
        "128",
        "--samples",
        "64"
      ]
    }
  ]
}

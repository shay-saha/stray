{
  "scope": "Time-limited corrected-data model improvement; all final targets sealed",
  "jobs": [
    {
      "name": "residence-aware-route-contender",
      "output": "runs/migration-repaired-residence-v1",
      "python_arguments": [
        "-m",
        "wildcast.migration_train",
        "--data",
        "data/migration-multiscale-repaired-v2/result",
        "--output",
        "runs/migration-repaired-residence-v1",
        "--variant",
        "residence_route",
        "--width",
        "512",
        "--layers",
        "6",
        "--components",
        "8",
        "--epochs",
        "16",
        "--patience",
        "4",
        "--batch-size",
        "512",
        "--sampling",
        "species_sqrt",
        "--seed",
        "42",
        "--validation-samples",
        "16",
        "--min-scale",
        "0.000005",
        "--covariance-jitter",
        "1e-12",
        "--matmul-precision",
        "high",
        "--device",
        "cuda"
      ]
    }
  ]

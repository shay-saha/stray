      "arguments": ["--epochs", "25", "--patience", "6", "--batch-size", "512", "--width", "128", "--layers", "3", "--driver-groups", "none", "--init-checkpoint", "runs/multispecies-seed7/best.pt", "--lr", "0.0001", "--stratified-energy", "--energy-weight", "1", "--nll-weight", "0.1", "--precision", "bf16"]

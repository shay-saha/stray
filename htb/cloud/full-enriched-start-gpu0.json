{
  "jobs": [
    {
      "name": "full-ecology-global",
      "task": "train",
      "data": "data/combined-ecology",
      "output": "runs/cloud/full-ecology-global",
      "arguments": [
        "--init-checkpoint",
        "runs/cloud/combined-memory-medium-seed17/best.pt",
        "--width",
        "256",
        "--layers",
        "4",
        "--components",
        "12",
        "--anchors",
        "--long-memory",
        "--driver-base-features",
        "180",
        "--student-df",
        "4",
        "--lr",
        "0.000001",
        "--epochs",
        "25",
        "--patience",
        "8",
        "--batch-size",
        "512",
        "--energy-weight",
        "1",
        "--nll-weight",
        "0.1",
        "--stratified-energy",
        "--energy-repeats",
        "2",
        "--precision",
        "bf16",
        "--preload",
        "--identity-audit",
        "reports/identity-audit.json",
        "--environment-lr",
        ".0001",
        "--environment-gate-lr",
        ".003"
      ]
    }
  ]
}
